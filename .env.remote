# 数据库配置
DATABASE_URL=mysql+pymysql://skillhub:skillhub123@localhost:3306/skill_hub

# MinIO 配置（远程服务器）
MINIO_ENDPOINT=8.133.242.214:19000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=root10kv
MINIO_SECURE=False
MINIO_USE_HTTPS=False

# MinIO 存储桶配置
DEFAULT_FILE_BUCKET=zhangling

# SSO 配置
SSO_CLIENT_ID=your_client_id
SSO_CLIENT_SECRET=your_client_secret
SSO_AUTHORIZE_URL=https://sso.example.com/oauth/authorize
SSO_TOKEN_URL=https://sso.example.com/oauth/token
SSO_USERINFO_URL=https://sso.example.com/oauth/userinfo
SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 应用配置
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
DEBUG=true

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
